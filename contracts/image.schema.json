{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InspectionImageSchema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "inspection_id": { "type": "string", "format": "uuid" },
    "view_type": {
      "type": "string",
      "enum": ["FRONT", "BACK", "SIDE", "TOP", "BOTTOM", "NUTRITION_PANEL", "MRP_PANEL", "OTHER"]
    },
    "original_filename": { "type": "string" },
    "storage_path": { "type": "string" },
    "processed_path": { "type": ["string", "null"] },
    "sha256_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "file_size_bytes": { "type": "integer", "minimum": 1 },
    "mime_type": { "type": "string" },
    "quality_assessment": {
      "type": "object",
      "properties": {
        "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "blur_score": { "type": "number" },
        "brightness_score": { "type": "number" },
        "contrast_score": { "type": "number" },
        "resolution_score": { "type": "number" },
        "orientation": {
          "type": "object",
          "properties": {
            "aspect_ratio": { "type": "number" },
            "layout": { "type": "string", "enum": ["PORTRAIT", "LANDSCAPE", "SQUARE"] },
            "estimated_skew_angle": { "type": "number" },
            "needs_rotation": { "type": "boolean" }
          }
        },
        "is_acceptable": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["quality_score", "blur_score", "brightness_score", "is_acceptable", "warnings"]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "inspection_id", "view_type", "original_filename", "storage_path", "sha256_hash", "width", "height"]
}
