{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleLensFindingSchema",
  "description": "RuleLens detailed compliance audit finding with traceable visual evidence",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "inspection_id": { "type": "string", "format": "uuid" },
    "requirement": { "type": "string" },
    "rule_id": { "type": "string" },
    "rule_version": { "type": "string" },
    "clause_reference": { "type": "string" },
    "observed_value": { "type": ["string", "null"] },
    "expected_condition": { "type": "string" },
    "evidence_image": { "type": ["string", "null"] },
    "bounding_box": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "ocr_text": { "type": ["string", "null"] },
    "ai_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNCERTAIN", "NOT_APPLICABLE"]
    },
    "ai_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNCERTAIN", "NOT_APPLICABLE"]
    },
    "final_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNCERTAIN", "NOT_APPLICABLE"]
    },
    "explanation": { "type": "string" },
    "uncertainty_reason": { "type": ["string", "null"] },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]
    },
    "inspector_status": {
      "type": ["string", "null"],
      "enum": ["PASS", "FAIL", "UNCERTAIN", "NOT_APPLICABLE", null]
    },
    "inspector_comment": { "type": ["string", "null"] },
    "inspector_id": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image_id": { "type": "string" },
          "view_type": { "type": "string" },
          "image_url": { "type": "string" },
          "processed_image_url": { "type": "string" },
          "bbox": { "type": "array", "items": { "type": "number" } },
          "ocr_text": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "id",
    "inspection_id",
    "requirement",
    "rule_id",
    "rule_version",
    "clause_reference",
    "expected_condition",
    "bounding_box",
    "ai_confidence",
    "decision",
    "explanation"
  ]
}
