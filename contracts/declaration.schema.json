{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeclarationSchema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "inspection_id": { "type": "string", "format": "uuid" },
    "source_image_id": { "type": "string", "format": "uuid" },
    "type": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "PRODUCT_NAME",
        "COMMON_GENERIC_NAME",
        "MANUFACTURER",
        "PACKER",
        "IMPORTER",
        "COUNTRY_OF_ORIGIN",
        "NET_QUANTITY",
        "MRP",
        "MANUFACTURE_DATE",
        "PACK_DATE",
        "BEST_BEFORE",
        "USE_BY",
        "CONSUMER_CARE",
        "UNIT_SALE_PRICE",
        "DIMENSIONS",
        "OTHER_DECLARATION"
      ]
    },
    "raw_text": { "type": "string" },
    "normalized_value": {
      "type": ["string", "number", "boolean", "object", "null"]
    },
    "unit": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "extraction_method": {
      "type": "string",
      "enum": ["REGEX_PATTERN", "KEYWORD_ANCHOR", "NLP_ENTITY", "SPATIAL_PROXIMITY", "MANUAL_ENTRY", "HYBRID"]
    },
    "is_inspector_edited": { "type": "boolean", "default": false },
    "original_ai_value": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "inspection_id", "source_image_id", "category", "raw_text", "confidence", "bbox"]
}
