{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OcrResultSchema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "image_id": { "type": "string", "format": "uuid" },
    "inspection_id": { "type": "string", "format": "uuid" },
    "engine_name": { "type": "string" },
    "engine_version": { "type": "string" },
    "processing_time_ms": { "type": "number", "minimum": 0 },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_index": { "type": "integer" },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x_min, y_min, x_max, y_max] normalized (0-1) or pixel coordinates"
          },
          "polygon": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "description": "4-corner polygon coordinates [[x1,y1],[x2,y2],[x3,y3],[x4,y4]]"
          }
        },
        "required": ["text", "confidence", "bbox"]
      }
    },
    "full_text": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "image_id", "inspection_id", "engine_name", "lines", "full_text"]
}
