{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InspectionSchema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "inspection_number": { "type": "string" },
    "inspector_id": { "type": "string" },
    "inspector_name": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "CAPTURED", "QUEUED", "UPLOADING", "ANALYZING", "REVIEW_REQUIRED", "FINALIZED", "SYNCED", "SYNC_FAILED"]
    },
    "compliance_status": {
      "type": "string",
      "enum": ["PENDING", "COMPLIANT", "NON_COMPLIANT", "REQUIRES_REVIEW"]
    },
    "commodity_name": { "type": "string" },
    "brand_name": { "type": ["string", "null"] },
    "rule_version": { "type": "string" },
    "total_images": { "type": "integer", "minimum": 0 },
    "findings_summary": {
      "type": "object",
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "uncertain": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 }
      },
      "required": ["pass", "fail", "uncertain", "not_applicable"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "finalized_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["id", "inspection_number", "status", "compliance_status", "created_at"]
}
