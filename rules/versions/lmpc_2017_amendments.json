        { "field": "MANUFACTURER", "operator": "EXISTS" },
        { "field": "NET_QUANTITY", "operator": "EXISTS" },
        { "field": "MRP", "operator": "EXISTS" },
        { "field": "CONSUMER_CARE", "operator": "EXISTS" }
      ]
    },
    "severity": "CRITICAL",
    "effective_from": "2018-01-01",
    "effective_to": null,
    "source_document": "Legal Metrology (Packaged Commodities) Amendment Rules, 2017 (GSR 629(E))",
    "source_url": "https://consumeraffairs.gov.in/pages/legal-metrology-act",
    "notes": "An e-commerce entity shall ensure that the mandatory declarations under sub-rule (1) except the month and year in which the commodity is manufactured or packed, are displayed on the digital marketplace."
  },
  {
