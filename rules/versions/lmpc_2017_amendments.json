    "rule_version": "LMPC-2017-AMENDMENT",
    "clause_reference": "Rule 6(10)",
    "requirement": "E-Commerce entity mandatory display of packaged commodity declarations",
    "applicability": {
      "is_ecommerce": true
    },
    "validation_logic": {
