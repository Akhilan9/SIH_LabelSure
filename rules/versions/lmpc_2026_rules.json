    "rule_id": "LMPC_2026_R06_1_A_MFG",
    "rule_version": "LMPC-2026-RULES",
    "clause_reference": "Rule 6(1)(a)",
    "requirement": "Name and complete physical address of the manufacturer or packer",
    "applicability": {
      "package_type": ["SINGLE_PRE_PACKAGED", "MULTI_PIECE", "COMBINATION"],
      "is_imported": false
    },
    "validation_logic": {
