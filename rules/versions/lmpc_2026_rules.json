      "operator": "EXISTS",
      "composite_conditions": [
        { "field": "PACKER", "operator": "EXISTS" }
      ]
    },
    "severity": "CRITICAL",
    "effective_from": "2026-01-01",
    "effective_to": null,
    "source_document": "Legal Metrology (Packaged Commodities) Modernized Compliance Rules, 2026",
    "source_url": "https://consumeraffairs.gov.in/pages/legal-metrology-act",
    "notes": "Every package must clearly declare manufacturer name, street address, and PIN code."
  },
  {
